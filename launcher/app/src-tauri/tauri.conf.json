{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bloodborne",
  "version": "0.4.1",
  "identifier": "io.github.pablovsouza.bloodborne-mac",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bloodborne",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "category": "RolePlayingGame",
    "copyright": "GPL-2.0-or-later. Based on bbport (deadinside28/bloodborne_pc) and shadPS4. No game files included.",
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
